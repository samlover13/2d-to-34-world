# Server-side Gemini & Veo credentials (NEVER ship inside the Android APK)
GEMINI_API_KEY="YOUR_BILLING_ENABLED_GEMINI_API_KEY"

# Google Cloud / Vertex AI + Cloud Storage settings
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
GCS_BUCKET_NAME="cartoon-ai-studio-media"
GOOGLE_APPLICATION_CREDENTIALS="/secrets/gcp-service-account.json"

# Persistent SQL database (SQLite default; use PostgreSQL in production e.g. postgresql+psycopg://...)
DATABASE_URL="sqlite:///./cartoon_ai_studio.db"

# Local temporary working directory for FFmpeg processing
WORK_DIR="/tmp/cartoon_ai_studio"
