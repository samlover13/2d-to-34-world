# GEMINI_API_KEY: Required for Google Gemini video analysis, 3D anime character reference generation, and Veo / Omni Flash video conversion.
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# Optional Google Cloud Storage settings (used by the FastAPI production backend)
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
GCS_BUCKET_NAME="cartoon-ai-studio-media"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
DATABASE_URL="sqlite:///./cartoon_ai_studio.db"
